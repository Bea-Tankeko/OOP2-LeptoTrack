
QMainWindow, QWidget#centralWidget, QWidget#frontPage {
    background-color: #10151D;
    color: #E6EDF5;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QLabel {
    background: transparent;
    color: #E6EDF5;
}

QFrame#welcomeCard,
QFrame#statCard,
QFrame#panel,
QFrame#capacityCard {
    background-color: #19222E;
    border: 1px solid #2C394A;
    border-radius: 12px;
}

QFrame#welcomeCard {
    min-width: 390px;
    max-width: 520px;
}

QLabel#pageTitle {
    color: #F3F7FC;
    font-size: 25pt;
    font-weight: 700;
}

QLabel#facilityName {
    color: #5EEAD4;
    font-size: 17pt;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #9BAABD;
    font-size: 10pt;
}

QLabel#scopeLabel {
    color: #5EEAD4;
    font-size: 8pt;
    font-weight: 700;
}

QLabel#statusBadge {
    background-color: #163A3A;
    color: #7CE8D5;
    border: 1px solid #28615D;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 8pt;
    font-weight: 700;
}

QLabel#statTitle {
    color: #9BAABD;
    font-size: 9pt;
    font-weight: 600;
}

QLabel#statValue {
    color: #F3F7FC;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: #F3F7FC;
    font-size: 13pt;
    font-weight: 700;
}

QLabel#chartPlaceholder,
QLabel#capacitySummary {
    background-color: #141C27;
    color: #8191A5;
    border: 1px dashed #344357;
    border-radius: 8px;
    padding: 16px;
}

QLabel#capacityTitle {
    color: #D8E2EF;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#capacityValue {
    color: #F3F7FC;
    font-size: 11pt;
    font-weight: 600;
}

QLabel#mutedText {
    color: #8191A5;
    font-size: 9pt;
}

QLabel#errorText {
    color: #FCA5A5;
    font-size: 9pt;
}

QLineEdit#facilityInput {
    background-color: #101720;
    color: #F3F7FC;
    border: 1px solid #3A4A5F;
    border-radius: 7px;
    padding: 12px;
    selection-background-color: #0F766E;
}

QLineEdit#facilityInput:focus {
    border: 1px solid #5EEAD4;
}

QPushButton {
    background-color: #263445;
    color: #E6EDF5;
    border: 1px solid #3A4A5F;
    border-radius: 7px;
    padding: 10px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #314359;
}

QPushButton:pressed {
    background-color: #1D2938;
}

QPushButton#primaryButton {
    background-color: #0F766E;
    color: #FFFFFF;
    border: none;
    padding: 12px 16px;
}

QPushButton#primaryButton:hover {
    background-color: #0D9488;
}

QPushButton[role="edit"] {
    background-color: #263445;
}

QPushButton[role="delete"] {
    background-color: #48282F;
    border-color: #70404A;
}

QPushButton[role="refresh"] {
    background-color: #203B43;
    border-color: #315761;
}

QProgressBar#capacityProgress {
    background-color: #2B3746;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#capacityProgress::chunk {
    background-color: #2DD4BF;
    border-radius: 4px;
}

QScrollBar:vertical {
    background-color: #141C27;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3A4A5F;
    border-radius: 4px;
    min-height: 25px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
